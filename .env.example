# ─── Evolution API ────────────────────────────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-api-key

# Instância padrão (fallback quando tenant não tem evolution_instance configurado)
EVOLUTION_INSTANCE=minha-empresa

# ─── Groq AI (gratuito: https://console.groq.com) ───────────────────────────
GROQ_API_KEY=your-groq-api-key

# ─── Aplicação ───────────────────────────────────────────────────────────────
# URL pública — aparece no link enviado ao operador (ex: https://meuservidor.com.br)
APP_URL=http://localhost:3000

# Número do operador padrão com DDI (usado como fallback para todos os tenants)
OPERATOR_PHONE=5511999999999

PORT=3000
NODE_ENV=production

# ─── Banco de dados ──────────────────────────────────────────────────────────
DATABASE_PATH=./data/atendimento.db

# ─── Multi-Tenant: configurar após subir o servidor ─────────────────────────
# Tenants são criados automaticamente no primeiro start.
# Para roteamento multi-número, defina a instância Evolution de cada tenant:
#   UPDATE tenants SET evolution_instance='barbearia-castilho' WHERE slug='barbearia-castilho';
#   UPDATE tenants SET evolution_instance='psicologa-prylucki' WHERE slug='psicologa-prylucki';
#
# Bases de conhecimento:
#   data/tenants/barbearia-castilho/knowledge-base.json
#   data/tenants/psicologa-prylucki/knowledge-base.json
