# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-api-key
EVOLUTION_INSTANCE=minha-empresa

# Groq AI (gratuito: https://console.groq.com)
GROQ_API_KEY=your-groq-api-key

# Operator / fallback phone for escalation alerts (used as default for all tenants)
# Each tenant can have its own operator_phone configured in the database
OPERATOR_PHONE=5511999999999

# Servidor
PORT=3000
NODE_ENV=production

# SQLite
DATABASE_PATH=./data/atendimento.db

# ─── Multi-Tenant Notes ──────────────────────────────────────────────────────
# Tenants are seeded automatically on startup via seedTenants():
#   - barbearia-castilho (type: ai_full)     → uses Groq AI + scheduling
#   - psicologa-prylucki (type: collect_forward) → collects fields, forwards to professional
#
# To configure per-tenant WhatsApp numbers for routing, update the tenants table:
#   UPDATE tenants SET whatsapp_phone = '5511888888888' WHERE slug = 'barbearia-castilho';
#   UPDATE tenants SET whatsapp_phone = '5511777777777' WHERE slug = 'psicologa-prylucki';
#
# Knowledge bases:
#   data/tenants/barbearia-castilho/knowledge-base.json
#   data/tenants/psicologa-prylucki/knowledge-base.json
