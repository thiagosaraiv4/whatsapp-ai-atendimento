{
  "name": "whatsapp-ai-atendimento",
  "version": "1.0.0",
  "description": "Automação de Atendimento WhatsApp com IA",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "setup": "node -e \"require('./dist/database').setupDatabase()\"",
    "test": "tsx --test tests/*.test.ts",
    "eval": "tsx evals/run-intent.ts",
    "eval:retrieval": "tsx evals/run-retrieval.ts",
    "eval:safety": "tsx evals/run-safety.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^9.4.3",
    "fastify": "^4.26.2",
    "groq-sdk": "^0.5.0",
    "dotenv": "^16.4.5",
    "axios": "^1.6.8",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.30",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.3"
  }
}
